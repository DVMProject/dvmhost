{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Digital Voice Modem - Talkgroup Rules",
    "description": "Schema for DVMHost and FNE group-voice admission, routing, rewrite, affiliation, encryption-strapping, and parrot rules.",
    "type": "object",
    "required": [ "groupVoice" ],
    "additionalProperties": false,
    "definitions": {
        "peerId": {
            "description": "Network peer ID. Peer IDs are positive integers and may not exceed the runtime network limit.",
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
        },
        "radioId": {
            "description": "Subscriber radio ID. Protocol-specific limits may be narrower than the common 32-bit representation.",
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
        },
        "talkgroupId": {
            "description": "Talkgroup ID. Protocol-specific limits may be narrower than the common 32-bit representation.",
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
        },
        "slot": {
            "description": "DMR slot number. FDMA protocols use slot 1 in the shared rule representation.",
            "type": "integer",
            "enum": [ 1, 2 ]
        },
        "peerIdList": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "$ref": "#/definitions/peerId"
            }
        }
    },
    "properties": {
        "groupVoice": {
            "description": "Nonempty list of canonical group-voice rules.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [ "name", "config", "source" ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "description": "Human-readable rule name used by logs and management interfaces.",
                        "type": "string",
                        "minLength": 1
                    },
                    "alias": {
                        "description": "Optional secondary display name or grouping label; it has no routing effect.",
                        "type": "string"
                    },
                    "config": {
                        "description": "Admission and routing policy for the canonical talkgroup.",
                        "type": "object",
                        "required": [ "active" ],
                        "additionalProperties": false,
                        "properties": {
                            "active": {
                                "description": "Whether the talkgroup is admitted and distributed as active.",
                                "type": "boolean"
                            },
                            "affiliated": {
                                "description": "Whether normal recipient sites must have a current group affiliation before traffic is repeated to them.",
                                "type": "boolean"
                            },
                            "strapping": {
                                "description": "Encryption-state policy: 0 selectable, 1 encrypted-only, 2 clear-only.",
                                "type": "integer",
                                "enum": [ 0, 1, 2 ]
                            },
                            "parrot": {
                                "description": "Whether eligible calls on this talkgroup are recorded and replayed by the FNE parrot service.",
                                "type": "boolean"
                            },
                            "inclusion": {
                                "description": "Peer allow-list. When nonempty, only listed normal peers are eligible; this takes precedence over exclusion.",
                                "$ref": "#/definitions/peerIdList"
                            },
                            "exclusion": {
                                "description": "Peer deny-list used only when inclusion is empty.",
                                "$ref": "#/definitions/peerIdList"
                            },
                            "rewrite": {
                                "description": "Per-peer external TGID/slot representations for bidirectional translation at that FNE boundary.",
                                "type": "array",
                                "uniqueItems": true,
                                "items": {
                                    "type": "object",
                                    "required": [ "peerid", "tgid", "slot" ],
                                    "additionalProperties": false,
                                    "properties": {
                                        "peerid": {
                                            "$ref": "#/definitions/peerId"
                                        },
                                        "tgid": {
                                            "$ref": "#/definitions/talkgroupId"
                                        },
                                        "slot": {
                                            "$ref": "#/definitions/slot"
                                        }
                                    }
                                }
                            },
                            "always": {
                                "description": "Peers that bypass affiliation and applicable unknown-RID gating after inclusion/exclusion filtering.",
                                "$ref": "#/definitions/peerIdList"
                            },
                            "preferred": {
                                "description": "Preferred trunking-site peer IDs. With a nonempty list, other visible peers are marked non-preferred to encourage subscriber roaming.",
                                "$ref": "#/definitions/peerIdList"
                            },
                            "rid_permitted": {
                                "description": "Subscriber RIDs admitted to affiliate with and originate on the talkgroup. An empty list admits all otherwise-authorized RIDs.",
                                "type": "array",
                                "uniqueItems": true,
                                "items": {
                                    "$ref": "#/definitions/radioId"
                                }
                            }
                        }
                    },
                    "source": {
                        "description": "Canonical talkgroup identity used internally by the FNE and host.",
                        "type": "object",
                        "required": [ "tgid", "slot" ],
                        "additionalProperties": false,
                        "properties": {
                            "tgid": {
                                "$ref": "#/definitions/talkgroupId"
                            },
                            "slot": {
                                "$ref": "#/definitions/slot"
                            }
                        }
                    }
                }
            }
        }
    }
}
